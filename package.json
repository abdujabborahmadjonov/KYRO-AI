{
  "name": "kyro-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KYRO AI — voice-powered, chart-aware storybooks (BraveTales) that prepare kids for their real procedures",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "seed": "tsx scripts/seed.ts",
    "index-corpus": "tsx scripts/index-corpus.ts",
    "smoke:voice": "node scripts/voice-smoke.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@deepgram/sdk": "^3.9.0",
    "@medplum/core": "^3.2.0",
    "@medplum/fhirtypes": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.3"
  }
}
