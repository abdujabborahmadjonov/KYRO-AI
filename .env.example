# All keys are OPTIONAL — every integration has a mock fallback for demos.

# Medplum (EHR / FHIR datastore). Without these, an in-memory FHIR store is used.
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Anthropic — story generation + conversation grounding
ANTHROPIC_API_KEY=

# Deepgram — voice agent (Flux STT + Aura TTS). Without it, the UI uses text chat.
DEEPGRAM_API_KEY=

# Moss — real-time retrieval. Without it, a local BM25 index over ./corpus is used.
MOSS_API_KEY=

# Stedi — eligibility (270/271, test mode). Without it, a mock 271 is returned.
STEDI_TEST_API_KEY=

# Express API port (the Vite web app proxies /api and /ws here)
API_PORT=8787
